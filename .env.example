GOOGLE_CLIENT_SECRET=""
OPENAI_API_KEY=""
GOOGLE_PLACES_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="proposals@yourdomain.com"
