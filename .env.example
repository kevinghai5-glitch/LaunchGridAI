# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/launchgrid"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""

# ─── Google Places API ───────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""

# ─── Google Maps API (static maps / geocoding in deliverables) ───────────────
GOOGLE_MAPS_API_KEY=""

# ─── Firecrawl (premium website scraping for audit grounding) ────────────────
FIRECRAWL_API_KEY=""

# ─── DataForSEO (SERP / keyword / local SEO intelligence) ────────────────────
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# ─── Google PageSpeed Insights (real Core Web Vitals in audit) ───────────────
PAGESPEED_API_KEY=""

# ─── ScreenshotOne (live site screenshots embedded in audit) ─────────────────
SCREENSHOTONE_ACCESS_KEY=""
SCREENSHOTONE_SECRET_KEY=""

# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
