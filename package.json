{
  "name": "launchgrid-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:check": "tsx scripts/gen-check.ts",
    "check:pack": "tsx scripts/check-pack.ts",
    "check:pack:sample": "tsx scripts/check-pack.ts _fixtures/golden-pack.json",
    "sample:golden": "tsx scripts/make-golden-sample.ts",
    "fixtures:clients": "tsx scripts/make-fixture-clients.ts",
    "samples:render": "tsx scripts/render-samples.ts",
    "test": "tsx scripts/leak-detection.test.ts",
    "verify:phase05": "tsx scripts/verify-phase05.ts",
    "verify:phase06": "tsx scripts/verify-phase06.ts",
    "verify:phase1": "tsx scripts/verify-phase1.ts",
    "verify:phase2": "tsx scripts/verify-phase2.ts",
    "verify:phase3": "tsx scripts/verify-phase3.ts",
    "verify:phase4": "tsx scripts/verify-phase4.ts",
    "verify:fabrication": "tsx scripts/verify-fabrication.ts",
    "probe:site": "tsx scripts/verify-fabrication.ts --probe",
    "verify:facts": "tsx scripts/verify-facts.ts",
    "verify:intake": "tsx scripts/verify-intake.ts",
    "verify:call-timing": "tsx scripts/verify-call-timing.ts",
    "verify:export": "tsx scripts/verify-export.ts",
    "verify:dial-status": "tsx scripts/verify-dial-status.ts",
    "verify:calculator": "tsx scripts/verify-calculator.ts",
    "verify:offer": "tsx scripts/verify-offer-page.ts",
    "verify:build-plan": "tsx scripts/verify-build-plan.ts",
    "verify:intake-screen": "tsx scripts/verify-intake-screen.ts",
    "verify:screenshots": "tsx scripts/verify-screenshots.ts",
    "verify:finding": "tsx scripts/verify-finding.ts",
    "verify:owner-name": "tsx scripts/verify-owner-name.ts",
    "verify:theme": "tsx scripts/verify-theme.ts",
    "scan:baseline": "tsx scripts/scan-baseline.ts",
    "verify:all": "npm run typecheck && npm run test && npm run verify:phase05 && npm run verify:phase06 && npm run verify:phase1 && npm run verify:phase2 && npm run verify:phase3 && npm run verify:phase4 && npm run verify:fabrication && npm run verify:facts && npm run verify:intake && npm run check:pack:sample && npm run verify:call-timing && npm run verify:export && npm run verify:dial-status && npm run verify:calculator && npm run verify:intake-screen && npm run verify:offer && npm run verify:build-plan && npm run verify:screenshots && npm run verify:finding && npm run verify:owner-name && npm run verify:theme",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.6.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@prisma/client": "^5.14.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.17",
    "jszip": "^3.10.1",
    "lucide-react": "^0.414.0",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "openai": "^4.52.7",
    "prisma": "^5.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
