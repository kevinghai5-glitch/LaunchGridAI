// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String    @unique
  emailVerified          DateTime?
  image                  String?
  hashedPassword         String?
  plan                   String    @default("free") // 'free' | 'pro'
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  // When the operator last opened the notifications dropdown. The bell's unread
  // badge counts real events (proposal opened/won, leads due) NEWER than this —
  // no notifications table, no fabricated feed: events are derived live from the
  // rows that already record them, and this timestamp is the only state.
  notificationsSeenAt    DateTime?

  accounts          Account[]
  sessions          Session[]
  businesses        Business[]
  generatedSystems  GeneratedSystem[]
  proposals         Proposal[]
  deals             Deal[]
  callLogs          CallLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Business {
  id            String   @id @default(cuid())
  userId        String
  googlePlaceId String?
  name          String
  address       String?
  phone         String?
  website       String?
  rating        Float?
  reviewCount   Int?
  latitude      Float?
  longitude     Float?
  mapsUrl       String?
  industry      String?
  city          String?
  category      String?
  description   String?
  photoUrl      String?
  favorited     Boolean  @default(false)
  // AI-suggested fields (all nullable)
  painPoint     String?
  outreachAngle String?
  suggestedOffer String?
  // Owner / decision-maker name, extracted once at cold-audit time from the
  // scraped About/Team pages (owner-name.ts). null = unknown or ambiguous — a
  // wrong name on a cold call is worse than none, so it's silent unless certain.
  ownerName     String?
  createdAt     DateTime @default(now())

  // --- Daily Call Queue (call-tracking) ---
  status        String    @default("QUEUED") // see LeadStatus in src/lib/call-queue.ts
  nextAction    String?                       // e.g. "Send audit", "Call back"
  nextActionAt  DateTime?                     // when the next action is due
  followUpUntil DateTime?                     // WAITING resurface date (hide until then)
  attemptCount  Int       @default(0)
  closedReason  String?                       // see ClosedReason; set on CLOSED/DEAD

  // --- CRM / daily-prospecting ---
  source         String    @default("MANUAL") // "MANUAL" (hand-saved) | "DAILY" (auto-sourced)
  notes          String?                       // freeform CRM notes on the contact record
  lastActivityAt DateTime?                     // last touch (call/status change) — powers "rotting" view
  declinedAt     DateTime?                     // when declined from a daily batch (resurface after a window)

  // --- Deliverable numbers (manually entered; power REAL-mode math in D1–D4) ---
  // All optional: blank → deliverables render in BENCHMARK mode (industry math),
  // provided → REAL mode ("based on the numbers you provided").
  avgClientValueCad Int?                        // average value of one closed customer, CAD
  monthlyLeadVolume Int?                        // inbound inquiries per month
  monthlyAdSpendCad Int?                        // monthly ad spend, CAD (legacy; no longer captured in UI)

  // --- Intake system booleans (null = unknown / not asked) ---
  // Drive REAL-mode leak framing in D1–D4: true suppresses the matching leak,
  // false renders it "Confirmed at intake", null keeps the benchmark hedge.
  hasCrm                  Boolean?              // has a CRM / lead-tracking pipeline
  hasFollowUpSequence     Boolean?              // has an automated follow-up sequence
  hasReminderSystem       Boolean?              // has an appointment reminder system
  hasPastCustomerDatabase Boolean?              // has a reachable past-customer list
  hasCallTracking         Boolean?              // tracks calls, answered vs missed — suppresses no_call_tracking
  hasOnlinePayment        Boolean?              // customer can pay / leave a deposit online — suppresses payment_booking_friction

  // --- Intake: how enquiries are actually handled today (null = not asked) ---
  // These are the three facts the detectors could previously only GUESS at, so
  // three leaks sat permanently at benchmark tier with no way to confirm or
  // suppress them. Same contract as the booleans above: the "handled" value
  // suppresses its leak, a "not handled" value confirms it at intake (declarative,
  // real math), and null/unknown keeps the benchmark hedge + kickoff-verify line.
  // Q "What happens when someone calls after hours?"
  //   "AUTO_RESPONSE" (handled) | "NEXT_MORNING" | "NOTHING" | "UNKNOWN".
  //   Gates no_after_hours_coverage.
  afterHoursHandling      String?
  // Q "What happens when you miss a call?"
  //   "INSTANT_TEXT_BACK" (handled) | "CALL_BACK_WHEN_FREE" | "VOICEMAIL_ONLY" | "UNKNOWN".
  //   Gates missed_calls_no_recovery.
  missedCallHandling      String?
  // Q "How fast does a new enquiry usually get a reply?"
  //   "UNDER_5_MIN" (handled) | "FEW_HOURS" | "DAY_OR_TWO" | "NOT_TRACKED".
  //   Gates slow_speed_to_lead.
  responseSpeed           String?
  // Q "Do enquiries come in through Instagram or Facebook messages?"
  //   "YES" | "NO" | "NO_ACCOUNTS".
  //   TWO CONSUMERS, deliberately — this is the only intake field that is both a
  //   leak fact and an applicability fact:
  //     1. It confirms social_dm_unmanaged. YES = enquiries really do arrive as
  //        DMs and nothing catches them (declarative, attributed). NO and
  //        NO_ACCOUNTS both suppress it — there is no leak in a channel that
  //        brings no enquiries.
  //     2. NO_ACCOUNTS is the fact that switches the Social DM Capture workflow
  //        OFF in the build. NO does NOT: they have the accounts, so the capture
  //        workflow still installs and simply sits quiet.
  socialEnquiries         String?
  // Q "When did you last contact past customers or old quotes?"
  //   "SYSTEMATIC" (handled) | "OCCASIONAL" | "OVER_A_YEAR" | "NEVER".
  //   Gates no_database_reactivation, and exists because hasPastCustomerDatabase
  //   could only ever SUPPRESS that leak, never confirm it: "no list" takes the
  //   leak off the report and "yes, a list" is what makes it fire, so the old
  //   question could not speak to the actual claim — that the list is DORMANT.
  //   The two now split cleanly: hasPastCustomerDatabase answers "is there a
  //   list?" (the applicability fact for the Database Reactivation workflow),
  //   this answers "is it going cold?" (the leak).
  pastCustomerContact     String?
  // Q "Do you take a deposit or payment before the work is done?"
  //   "ALWAYS" | "SOMETIMES" | "NEVER".
  //   The applicability fact for the Text-to-Pay workflow, and ONLY that.
  //
  //   DO NOT MERGE THIS WITH hasOnlinePayment. They look like the same question
  //   and they run in OPPOSITE directions. A business that takes deposits but has
  //   no online way to collect them is the BEST Text-to-Pay candidate, not the
  //   worst — they are chasing e-transfers and cheques by hand today. So:
  //     takesDeposits ALWAYS/SOMETIMES → install (and hasOnlinePayment === false
  //       raises its PRIORITY, which is a separate signal from on/off)
  //     takesDeposits NEVER            → the only case that switches it OFF
  //   hasOnlinePayment must never reach the on/off rule: it does one job, which is
  //   suppressing payment_booking_friction.
  takesDeposits           String?
  // Q "Who replies to your Google reviews right now?"
  //   "NOBODY" | "OWNER" | "STAFF_OR_AGENCY".
  //
  //   Deliberately a PROCESS question, not a preference one. "Do you write your own
  //   replies?" invites a scope answer; "who replies right now?" is a fact about how
  //   the business runs today — the same rule the cold call uses ("what happens
  //   when…"). It earns its keep twice: NOBODY is itself a finding worth putting in
  //   the report, and OWNER is the only answer that makes switching Review Response
  //   off reasonable — but it does NOT switch it off automatically. An owner who
  //   writes his own replies still benefits from having drafts ready, so the
  //   workflow installs and the operator removes it by hand if the client insists.
  reviewReplyOwner        String?

  // --- Workflow applicability overrides (Phase 2) ---
  // The operator's EXPLICIT decisions about which of the 14 GoHighLevel workflows
  // this client's build includes, as { [workflowId]: boolean }.
  //
  // ONLY OVERRIDES ARE STORED, never the resolved set. Each workflow already has
  // a default (10 on, 4 conditional on an intake fact), so persisting the whole
  // resolved map would freeze today's defaults into every existing client — change
  // a default later and the clients who never touched it would keep the old one.
  // An absent key means "no opinion, use the rule", which is the state almost every
  // workflow stays in.
  //
  // Persisted so regeneration is DETERMINISTIC: the same client regenerated
  // tomorrow gets the same build, not whatever the detectors happen to fire today.
  workflowToggles         Json?
  // Services they want more of — from the intake form. COPY EMPHASIS ONLY:
  // shapes generated wording, never leak selection / tiers / scores / math.
  servicesFocus           String?

  // --- Intake form: booking / GBP / build priorities (all nullable = not asked) ---
  // Mirror the ReclaimedHQ client intake form verbatim.
  // Q "How do people book with you right now?" — "PHONE_EMAIL_ONLY" | "BOOKING_TOOL" | "OTHER".
  //   Gates no_online_booking: BOOKING_TOOL suppresses (reframe as connect+optimize
  //   the named tool); PHONE_EMAIL_ONLY confirms the gap (declarative + dollars);
  //   OTHER/null → hedged + kickoff-verify.
  bookingMethod           String?
  bookingToolName         String?               // the "which one" when bookingMethod = BOOKING_TOOL
  // Q "Do you manage your own Google Business listing?" — "SELF" (Yes) | "NOT_SELF" (No)
  //   | "SOMEONE_ELSE" (Someone else does) | "NOT_SURE". FRAMING ONLY for the review
  //   engine — never suppresses review leaks (review data is API-observed regardless).
  gbpManagement           String?
  // Q "Which of these do you want PRIORITIZED in your build?" — comma-separated slugs
  //   from a fixed 10-option checkbox. ORDERING + copy emphasis ONLY for the Blueprint;
  //   never adds/removes/reweights a leak, score, or dollar figure.
  buildPriorities         String?

  // --- PageSpeed snapshot (Part H3) ---
  // Measured once per business, then reused verbatim across every artifact (cold
  // audit + all deliverables) so PSI numbers never diverge between runs.
  psiSnapshot   Json?                           // serialized PsiBundle
  psiSnapshotAt DateTime?                        // when the snapshot was taken (TTL refresh)

  // --- Research snapshot (determinism fix 2) ---
  // The full enrichment bundle (native page, Places reviews, competitors,
  // Firecrawl scrape, DataForSeo) captured ONCE and reused verbatim on every
  // regenerate. Regenerate alone is a zero-scrape, zero-API-cost operation; fresh
  // data is a deliberate "refresh research" action, never a side effect. Carries
  // an `asOf` timestamp that also freezes date-window logic (fix 3).
  researchSnapshot   Json?                        // serialized ResearchBundle
  researchSnapshotAt DateTime?                     // when the bundle was captured (TTL + clock freeze)

  // --- Soft delete ---
  // We NEVER hard-delete. "Clear / Remove / Delete" sets deletedAt; the row stays
  // in the DB and is filtered out of reads (deletedAt: null). Always recoverable.
  deletedAt DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedSystems GeneratedSystem[]
  proposals        Proposal[]
  deals            Deal[]
  callLogs         CallLog[]
}

model GeneratedSystem {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  type       String   // 'LEAD' | 'CONTENT' | 'ASSETS' | 'COLD_AUDIT'
  content    Json
  // Public share id — used to host a cold-audit teaser at /a/[publicId] so the
  // pre-zoom GHL email can link the audit. Present on every row; only COLD_AUDIT
  // rows have a public page.
  publicId   String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  // Soft delete — never hard-deleted; filtered out of reads via deletedAt: null.
  deletedAt  DateTime?

  // --- Governance override paper trail (Phase 0.6) ---
  // A fatal validator check BLOCKS save and export. The override exists so the
  // operator is never physically unable to deliver at 11pm because a rule
  // false-positived — the alternative is that they comment the gate out, and then
  // enforcement is off permanently and silently. It is never a config flag and
  // never an env var: it costs a deliberate act plus a typed reason, and it leaves
  // these three columns behind. All null on a normally-validated row.
  overrideReason   String?   // the operator's free-text justification — required
  overriddenChecks Json?     // ValidationCheck[] that were fatal at the time
  overriddenAt     DateTime? // when the override was exercised

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Proposal {
  id               String   @id @default(cuid())
  userId           String
  businessId       String
  title            String
  agencyName       String?
  packageOverview  String
  // Two-part bespoke investment, CAD: one-time done-for-you setup (four
  // deliverables + the GoHighLevel build) + the LeadGate monthly retainer.
  setupFee         Int      @default(6500)
  monthlyPrice     Int      @default(1000)
  // Structured conversion-proposal sections (see ProposalContent in types).
  deliverables     Json     // ProposalComponent[] — what we deploy, tied to leaks
  problem          Json?    // ProposalProblem — diagnosed leaks + dollar cost
  roi              Json?    // ProposalRoi
  scope            Json?    // ProposalScope (included / excluded)
  timeline         Json?    // ProposalPhase[]
  proof            Json?    // ProposalProof (testimonials placeholder)
  faq              Json?    // ProposalFaq[]
  nextSteps        String?
  emailMessage     String?
  // Legacy column retained for back-compat with older rows.
  benefits         Json     @default("[]")
  publicId         String   @unique @default(cuid())
  status           String   @default("DRAFT") // 'DRAFT' | 'SENT' | 'VIEWED' | 'ACCEPTED' | 'REJECTED'
  systemsIncluded  Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // Soft delete — never hard-deleted; filtered out of reads via deletedAt: null.
  deletedAt        DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deals    Deal[]
}

model Deal {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  proposalId  String?
  stage       String   @default("SAVED") // 'SAVED' | 'SYSTEMS_GENERATED' | 'PROPOSAL_SENT' | 'FOLLOW_UP' | 'WON' | 'LOST'
  monthlyValue Int     @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Soft delete — never hard-deleted; filtered out of reads via deletedAt: null.
  deletedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  proposal Proposal? @relation(fields: [proposalId], references: [id])
}

// Append-only log of every call attempt against a lead (Business). One row per
// attempt; never updated. Powers attemptCount + the "last outcome" peek.
model CallLog {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  disposition String   // see Disposition in src/lib/call-queue.ts
  note        String?  // convention: "[objection] | [detail] | [commitment]"
  durationSec Int?
  calledAt    DateTime @default(now())
  // Soft delete — never hard-deleted; filtered out of reads via deletedAt: null.
  deletedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
}
